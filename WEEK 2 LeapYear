import java.util.Scanner;
public class LeapYear {

    public boolean IsLeapYear()
    {
      Scanner sc=new Scanner(System.in);

      System.out.println("ENTER THE YEAR");

      int year=sc.nextInt();
      if(year%4==0)
      {
        return true;
      }
      else
      {
        return false;
      }
        
    }
}
