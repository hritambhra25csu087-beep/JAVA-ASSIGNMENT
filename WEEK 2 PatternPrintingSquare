import java.util.Scanner;
public class PatternPrintingSquare {
    public static void printPattern(int n)

    {
        Scanner sc= new Scanner(System.in);
        System.out.println("Enter the number of rows for the pattern: ");
        n = sc.nextInt();
        for(int i=1;i<=n;i++)
        {
            for(int j=1;j<=n;j++)
            {
System.out.print("* ");
            }
            System.out.println();
        }
    }

}
