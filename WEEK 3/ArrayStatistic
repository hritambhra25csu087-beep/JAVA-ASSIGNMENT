import java.util.Scanner;
public class ArrayStatistic {
    public static void  ReadArray(String[] args)
    {
 Scanner sc = new Scanner(System.in);
 System.out.println("Enter the size of the array");
 int n= sc.nextInt();
 int[] arr=new int [n];
 System.out.println("Enter the elements of the array");
 for(int i=0;i<n;i++)
 {
    arr[i]=sc.nextInt();
 }
    }

    public int ArraySum(int[] arr)
    {
        int sum=0;
        for(int i=0;i<arr.length;i++)
        {
            sum+=arr[i];
        }
        System.out.println("The sum of the array is: "+sum);
        return sum;
    }

    public double ArrayAverage(int[] arr)
    {
         double sum=ArraySum( arr);
        System.out.println("The average of the array is: "+ sum/(arr.length));
        return (double)sum/(arr.length);
    }

    public int ArrayMax(int[] arr)
    {
        int max = Integer.MIN_VALUE;
        for(int i = 0;i < arr.length;i++)
        {
            if(arr[i] > max)
            {
                max = arr[i];
            }
        }
        System.out.println("THE MAXIMUM VALUE OF THE ARRAY :"+max);
        return max;
    }
    public int ArrayMin(int[] arr)
    {
        int min = Integer.MAX_VALUE;
        for(int i = 0; i < arr.length; i++)
        {
            if(arr[i] < min)
            {
                min = arr[i];
            }
        }
        return min;
    }
    public int CountEven(int[] arr)
    {
        int count=0;
        for(int i=0;i<arr.length;i++)
        {
            if(arr[i]%2==0)
            {
                count++;
            }
        }
return count;
    }
    public void PrintSignCounts(int[] arr)
    {
        int negative=0;
        int positive=0;
        int IsZero=0;

{
    for(int i=0;i<arr.length;i++)
    {
        if(arr[i]<0)
        {
             negative++;
               System.out.println(negative);
           }
        else if (arr[i]>0) {
            positive++;
            System.out.println("positive");
        }
        else
        {
            IsZero++;
            System.out.println("zero");
        }
    }
}
    
        
    }

}
