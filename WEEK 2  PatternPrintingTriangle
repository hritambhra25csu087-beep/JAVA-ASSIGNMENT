import java.util.Scanner;
public class PatternPrintingTriangle {
    public static void printPattern()
    {
        Scanner sc= new Scanner(System.in);
        System.out.println("Enter the number of rows for the pattern: ");
        int n = sc.nextInt();
        for(int i=1;i<=n;i++)
        {
            for(int j=1;j<=i;j++)
            {
                System.out.print("* ");
            }
            System.out.println();
        }
    }


}
